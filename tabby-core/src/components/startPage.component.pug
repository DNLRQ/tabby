
.mt-auto.mb-auto.start-page-body
    .tabby-logo
    h1.tabby-title Tabby
        sup α

    .quick-access(*ngIf='config.store.showQuickAccess')
        h2.quick-access-title(translate) Quick access
        .quick-access-cards(*ngIf='recentProfiles.length')
            ng-container(*ngFor='let profile of recentProfiles; trackBy: profilesTrackBy')
                ng-container(*ngTemplateOutlet='profileCard; context: {$implicit: profile}')
        .quick-access-empty.text-muted(*ngIf='!recentProfiles.length', translate) No recent connections

    .connection-groups(*ngIf='config.store.showGroupedConnections && connectionGroups.length')
        h2.quick-access-title(translate) Connections
        .connection-group(*ngFor='let group of connectionGroups; trackBy: groupsTrackBy')
            .connection-group-head
                .connection-group-label
                    i.connection-group-icon(
                        *ngIf='group.icon',
                        [ngClass]='group.icon',
                        [style.color]='group.color'
                    )
                    i.fas.fa-layer-group.connection-group-icon(*ngIf='!group.icon', [style.color]='group.color')
                    h3.connection-group-name {{group.name}}
                span.connection-group-count {{group.profiles.length}}
            .connection-group-scroller
                ng-container(*ngFor='let profile of group.profiles; trackBy: profilesTrackBy')
                    ng-container(*ngTemplateOutlet='profileCard; context: {$implicit: profile}')

    ng-template(#profileCard let-profile)
        button.home-card(
            type='button',
            [class.is-open]='isProfileOpen(profile)',
            (click)='launchProfile(profile)',
        )
            .home-card-top
                profile-icon.home-card-icon(
                    [icon]='getProfileIcon(profile)',
                    [color]='profile.color'
                )
                span([ngClass]='getTypeBadgeClass(profile)') {{getTypeLabel(profile)}}
            .home-card-name {{profile.name}}
            .home-card-foot
                .home-card-host(*ngIf='getHostLabel(profile)') {{getHostLabel(profile)}}
                .home-card-meta
                    .home-card-stat
                        span.home-card-stat-label(translate) Last used
                        span.home-card-stat-value {{getLastUsedLabel(profile)}}
                    span.home-card-led(
                        *ngIf='isProfileOpen(profile)',
                        [ngbTooltip]='"Connected"|translate'
                    )

    .start-page-actions.mb-4
        button.btn.btn-primary.btn-new-connection(
            type='button',
            *ngIf='config.store.showNewConnectionButton && newConnectionCommand',
            (click)='createNewConnection()',
        )
            i.fas.fa-plus.me-2
            span(translate) New connection

        .list-group(*ngIf='commands.length')
            a.list-group-item.list-group-item-action.d-flex.pt-3.pb-3(
                *ngFor='let command of commands; trackBy: buttonsTrackBy',
                (click)='command.run()',
            )
                .d-flex.align-self-center([innerHTML]='sanitizeIcon(command.icon)')
                span {{command.label}}

footer.d-flex.align-items-center
    .btn-group.me-auto
        button.btn.btn-link((click)='homeBase.openGitHub()')
            i.fab.fa-github
            span GitHub
        button.btn.btn-link((click)='homeBase.reportBug()')
            i.fas.fa-bug
            span(translate) Report a problem

    .form-control-static.selectable.no-drag(
        translate='Version: {version}',
        [translateParams]='{ version: this.homeBase.appVersion }'
    )
