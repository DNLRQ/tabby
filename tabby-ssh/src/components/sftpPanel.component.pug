.sftp-sheet
    .sftp-handle
    .sftp-header
        .sftp-header-main
            .sftp-brand
                .sftp-brand-icon
                    i.fas.fa-folder-open
                .sftp-brand-text
                    .sftp-brand-title SFTP
                    .sftp-brand-host(*ngIf='hostLabel') {{hostLabel}}

            .sftp-search
                i.fas.fa-search
                input.sftp-search-input(
                    type='text',
                    [placeholder]='"Search files"|translate',
                    [(ngModel)]='filterText',
                    (input)='onFilterChange()',
                    (keydown.escape)='clearFilter()'
                )
                button.sftp-search-clear(*ngIf='filterText', (click)='clearFilter()', type='button')
                    i.fas.fa-times

            .sftp-header-actions
                .sftp-view-toggle
                    button.sftp-icon-btn(
                        type='button',
                        [class.active]='viewMode === "grid"',
                        [ngbTooltip]='"Grid view"|translate',
                        (click)='setViewMode("grid")'
                    )
                        i.fas.fa-th-large
                    button.sftp-icon-btn(
                        type='button',
                        [class.active]='viewMode === "list"',
                        [ngbTooltip]='"List view"|translate',
                        (click)='setViewMode("list")'
                    )
                        i.fas.fa-list

                button.sftp-icon-btn(
                    type='button',
                    [class.active]='showHidden',
                    [ngbTooltip]='(showHidden ? "Hide hidden files" : "Show hidden files")|translate',
                    (click)='toggleHidden()'
                )
                    i.fas.fa-eye(*ngIf='!showHidden')
                    i.fas.fa-eye-slash(*ngIf='showHidden')

                button.sftp-icon-btn(
                    type='button',
                    [ngbTooltip]='"Transfer history"|translate',
                    (click)='openTransferLog()'
                )
                    i.fas.fa-history

                button.sftp-icon-btn(
                    type='button',
                    [ngbTooltip]='(standalone ? "New window" : "Open in tab")|translate',
                    (click)='openNewWindow()'
                )
                    i.fas.fa-clone(*ngIf='standalone')
                    i.fas.fa-external-link-alt(*ngIf='!standalone')

                button.sftp-icon-btn.sftp-close(
                    type='button',
                    [ngbTooltip]='"Close"|translate',
                    (click)='close()'
                )
                    i.fas.fa-times

        .sftp-header-nav
            input.sftp-path-input(
                *ngIf='editingPath !== null',
                type='text',
                autofocus,
                (keydown.enter)='confirmPath()',
                (keydown.esc)='editingPath = null',
                (blur)='editingPath = null',
                [(ngModel)]='editingPath'
            )
            .sftp-crumbs(*ngIf='editingPath === null', (dblclick)='editPath()')
                button.sftp-crumb.sftp-crumb-root(type='button', (click)='navigate("/")')
                    i.fas.fa-hdd
                    span SFTP
                button.sftp-crumb(
                    *ngFor='let segment of pathSegments',
                    type='button',
                    (click)='navigate(segment.path)'
                )
                    i.fas.fa-chevron-right.sftp-crumb-sep
                    span {{segment.name}}

            .sftp-nav-actions
                button.sftp-action(type='button', (click)='navigate(path)')
                    i.fas.fa-sync-alt
                    span(translate) Refresh
                button.sftp-action(type='button', (click)='openCreateDirectoryModal()')
                    i.fas.fa-folder-plus
                    span(translate) Create directory
                button.sftp-action(type='button', (click)='openCreateFileModal()')
                    i.fas.fa-file
                    span(translate) New file
                button.sftp-action(type='button', (click)='upload()')
                    i.fas.fa-upload
                    span(translate) Upload files
                button.sftp-action(type='button', (click)='uploadFolder()')
                    i.fas.fa-folder-open
                    span(translate) Upload folder

    .sftp-progress(*ngIf='hasActiveTransfers')
        .sftp-progress-top
            .sftp-progress-name([ngbTooltip]='transferLabel') {{transferLabel}}
            .sftp-progress-file(*ngIf='transferStatus') {{transferStatus}}
            .sftp-progress-pct {{transferPercent}}%
        ngb-progressbar.sftp-progress-bar(
            [type]='transferPercent >= 100 ? "success" : "info"',
            [value]='transferPercent',
            [striped]='true',
            [animated]='transferPercent < 100',
            height='8px'
        )
        .sftp-progress-meta
            span {{transferCompleted|filesize}} / {{transferTotal|filesize}}
            span.sftp-progress-remain(*ngIf='transferRemaining') {{transferRemaining|filesize}} {{'remaining'|translate}}
            span.sftp-progress-speed(*ngIf='transferSpeed') {{transferSpeed|filesize}}/s

    .sftp-body(
        tabindex='-1',
        [class.is-marquee]='!!marqueeBox',
        (click)='onBackgroundClick($event)',
        (mousedown)='onMarqueeMouseDown($event)',
        (dragenter)='onDragEnter($event)',
        (dragover)='onDragOver($event)',
        (dragleave)='onDragLeave($event)',
        (drop)='onDrop($event)'
    )
        .sftp-marquee(*ngIf='marqueeBox', [ngStyle]='marqueeStyle')
        .sftp-drop-overlay(*ngIf='isDragging && sftpConfig.dragAndDrop && !isInternalDrag')
            .sftp-drop-overlay-inner
                i.fas.fa-cloud-upload-alt
                span(translate) Drop files to upload here
        a.sftp-tip(
            *ngIf='shouldShowCWDTip && !cwdDetectionAvailable',
            (click)='platform.openExternal("https://tabby.sh/go/cwd-detection")'
        )
            .sftp-tip-text
                strong(translate) Working directory detection
                div(translate) Learn how to allow Tabby to detect remote shell's working directory.
            button.sftp-tip-close(type='button', (click)='dismissCWDTip(); $event.preventDefault(); $event.stopPropagation()')
                i.fas.fa-times

        .sftp-status(*ngIf='!sftp || fileList === null')
            .sftp-spinner
            div(*ngIf='!sftp', translate) Connecting
            div(*ngIf='sftp && fileList === null', translate) Loading

        div.sftp-content(*ngIf='sftp && fileList !== null')
            .sftp-empty(*ngIf='filteredFileList.length === 0 && (path === "/" || filterText.trim())')
                .sftp-empty-icon
                    i.fas.fa-search(*ngIf='filterText.trim()')
                    i.fas.fa-folder-open(*ngIf='!filterText.trim()')
                .sftp-empty-title(*ngIf='filterText.trim()')
                    span(translate) No matching files
                    span : {{filterText}}
                .sftp-empty-title(*ngIf='!filterText.trim()', translate) Empty folder
                .sftp-empty-copy(*ngIf='!filterText.trim()', translate) Drop files here or use the upload buttons

            .sftp-grid(*ngIf='viewMode === "grid" && (filteredFileList.length || (path !== "/" && !filterText.trim()))')
                button.sftp-card.sftp-card-up(
                    *ngIf='path !== "/" && !filterText.trim()',
                    type='button',
                    [class.drop-target]='dropTargetPath === ".."',
                    (click)='goUp(); $event.stopPropagation()',
                    (dragover)='onGoUpDragOver($event)',
                    (dragleave)='onDropTargetLeave($event)',
                    (drop)='onGoUpDrop($event)'
                )
                    .sftp-card-icon.kind-up
                        i.fas.fa-level-up-alt
                    .sftp-card-name(translate) Go up
                    .sftp-card-meta

                button.sftp-card(
                    *ngFor='let item of filteredFileList; trackBy: trackByPath',
                    type='button',
                    [attr.data-sftp-path]='item.fullPath',
                    [class.is-dir]='item.isDirectory',
                    [class.selected]='isSelected(item)',
                    draggable='true',
                    [class.drop-target]='dropTargetPath === item.fullPath',
                    (dragstart)='onItemDragStart(item, $event)',
                    (dragend)='onItemDragEnd()',
                    (dragover)='onItemDragOver(item, $event)',
                    (dragleave)='onDropTargetLeave($event)',
                    (drop)='onItemDrop(item, $event)',
                    (contextmenu)='showContextMenu(item, $event)',
                    (click)='onItemClick(item, $event)',
                    (dblclick)='onItemDblClick(item, $event)'
                )
                    .sftp-card-icon([class]='kindClass(item)')
                        i([class]='getIcon(item)')
                    .sftp-card-name {{item.name}}
                    .sftp-card-meta(*ngIf='item.isDirectory', translate) Folder
                    .sftp-card-meta(*ngIf='!item.isDirectory') {{item.size|filesize}}
                    button.sftp-card-download(
                        *ngIf='sftpConfig.showDownloadButton',
                        type='button',
                        [ngbTooltip]='"Download"|translate',
                        (click)='downloadItem(item); $event.stopPropagation()'
                    )
                        i.fas.fa-download

            .sftp-list(*ngIf='viewMode === "list" && (filteredFileList.length || (path !== "/" && !filterText.trim()))')
                .sftp-list-head
                    span.sftp-col-name(translate) Name
                    span.sftp-col-size(translate) Size
                    span.sftp-col-date(translate) Date
                    span.sftp-col-mode
                    span.sftp-col-action

                button.sftp-row.sftp-row-up(
                    *ngIf='path !== "/" && !filterText.trim()',
                    type='button',
                    [class.drop-target]='dropTargetPath === ".."',
                    (click)='goUp(); $event.stopPropagation()',
                    (dragover)='onGoUpDragOver($event)',
                    (dragleave)='onDropTargetLeave($event)',
                    (drop)='onGoUpDrop($event)'
                )
                    .sftp-col-name
                        .sftp-row-icon.kind-up
                            i.fas.fa-level-up-alt
                        span(translate) Go up
                    .sftp-col-size
                    .sftp-col-date
                    .sftp-col-mode
                    .sftp-col-action

                button.sftp-row(
                    *ngFor='let item of filteredFileList; trackBy: trackByPath',
                    type='button',
                    [attr.data-sftp-path]='item.fullPath',
                    [class.is-dir]='item.isDirectory',
                    [class.selected]='isSelected(item)',
                    draggable='true',
                    [class.drop-target]='dropTargetPath === item.fullPath',
                    (dragstart)='onItemDragStart(item, $event)',
                    (dragend)='onItemDragEnd()',
                    (dragover)='onItemDragOver(item, $event)',
                    (dragleave)='onDropTargetLeave($event)',
                    (drop)='onItemDrop(item, $event)',
                    (contextmenu)='showContextMenu(item, $event)',
                    (click)='onItemClick(item, $event)',
                    (dblclick)='onItemDblClick(item, $event)'
                )
                    .sftp-col-name
                        .sftp-row-icon([class]='kindClass(item)')
                            i([class]='getIcon(item)')
                        span {{item.name}}
                    .sftp-col-size(*ngIf='item.isDirectory') —
                    .sftp-col-size(*ngIf='!item.isDirectory') {{item.size|filesize}}
                    .sftp-col-date {{item.modified|tabbyDate}}
                    .sftp-col-mode {{getModeString(item)}}
                    .sftp-col-action
                        button.sftp-icon-btn(
                            *ngIf='sftpConfig.showDownloadButton',
                            type='button',
                            [ngbTooltip]='"Download"|translate',
                            (click)='downloadItem(item); $event.stopPropagation()'
                        )
                            i.fas.fa-download

    .sftp-footer(*ngIf='sftp && fileList !== null')
        .sftp-footer-info(*ngIf='selectedCount === 0')
            span {{folderCount}} {{'folders'|translate}}
            span.sftp-footer-dot ·
            span {{fileCount}} {{'files'|translate}}
            span.sftp-footer-hint(*ngIf='sftpConfig.dragAndDrop', translate) Drop files to upload
            button.sftp-footer-action(*ngIf='hasClipboard', type='button', (click)='pasteClipboard(); $event.stopPropagation()')
                i.fas.fa-paste
                span(translate) Paste
        .sftp-footer-info(*ngIf='selectedCount > 0')
            span {{selectedCount}} {{'selected'|translate}}
            button.sftp-footer-action(type='button', (click)='downloadSelected(); $event.stopPropagation()')
                i.fas.fa-download
                span(translate) Download
            button.sftp-footer-action(type='button', (click)='sendSelected(); $event.stopPropagation()')
                i.fas.fa-exchange-alt
                span(translate) Send to
            button.sftp-footer-action(type='button', (click)='copySelected(); $event.stopPropagation()')
                i.fas.fa-copy
                span(translate) Copy
            button.sftp-footer-action(type='button', (click)='cutSelected(); $event.stopPropagation()')
                i.fas.fa-cut
                span(translate) Cut
            button.sftp-footer-action(*ngIf='hasClipboard', type='button', (click)='pasteClipboard(); $event.stopPropagation()')
                i.fas.fa-paste
                span(translate) Paste
            button.sftp-footer-action(*ngIf='selectedCount === 1', type='button', (click)='renameSelected(); $event.stopPropagation()')
                i.fas.fa-i-cursor
                span(translate) Rename
            button.sftp-footer-action.danger(type='button', (click)='deleteSelected(); $event.stopPropagation()')
                i.fas.fa-trash-alt
                span(translate) Delete
            button.sftp-footer-action(type='button', (click)='clearSelection(); $event.stopPropagation()')
                i.fas.fa-times
        span.sftp-footer-path {{path}}
